# Sao chép file này thành .env rồi đổi mật khẩu.
NODE_ENV=development

# API
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# SQL Server (docker compose đọc cùng file .env này).
# Mật khẩu phải >= 8 ký tự, có chữ hoa, chữ thường, số và ký tự đặc biệt.
# Chỉ dùng tài khoản sa cho môi trường dev trên máy cá nhân.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=ai_coach
DB_USER=sa
DB_PASSWORD=ChangeMe_2026!

# Auth: JWT_SECRET là chuỗi ngẫu nhiên >= 32 ký tự, mỗi máy một giá trị riêng.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_TTL_MINUTES=60

# Ollama chạy native trên Windows. KHÔNG mở cổng 11434 ra ngoài mạng.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
