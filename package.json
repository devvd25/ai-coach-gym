{
  "name": "ai-coach-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @ai-coach/shared build && pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm --filter @ai-coach/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @ai-coach/shared build && pnpm -r test",
    "db:up": "docker compose up -d --wait sqlserver",
    "db:down": "docker compose down",
    "db:create": "pnpm --filter @ai-coach/api db:create",
    "db:migrate": "pnpm --filter @ai-coach/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
