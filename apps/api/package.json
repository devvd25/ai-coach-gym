{
  "name": "@ai-coach/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:create": "sequelize-cli db:create --config src/db/config.cjs",
    "db:migrate": "sequelize-cli db:migrate --config src/db/config.cjs --migrations-path src/db/migrations",
    "db:migrate:undo": "sequelize-cli db:migrate:undo --config src/db/config.cjs --migrations-path src/db/migrations",
    "db:seed": "sequelize-cli db:seed:all --config src/db/config.cjs --seeders-path src/db/seeders",
    "export:training": "tsx src/scripts/export-training.ts"
  },
  "dependencies": {
    "@ai-coach/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "ollama": "^0.6.4",
    "sequelize": "^6.37.8",
    "tedious": "^20.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
